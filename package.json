{
  "name": "easystore",
  "version": "1.0.0",
  "description": "EasyStore: a one-click online store for any kind of shop (Next.js, PostgreSQL)",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && next build",
    "postinstall": "prisma generate",
    "start": "next start",
    "lint": "eslint src",
    "db:generate": "prisma generate",
    "db:push": "prisma db push",
    "db:migrate": "prisma migrate dev",
    "preview": "opennextjs-cloudflare build && opennextjs-cloudflare preview",
    "deploy": "opennextjs-cloudflare build && opennextjs-cloudflare deploy",
    "upload": "opennextjs-cloudflare build && opennextjs-cloudflare upload",
    "cf-typegen": "wrangler types --env-interface CloudflareEnv --include-runtime=false cloudflare-env.d.ts",
    "vercel-build": "prisma generate && prisma db push --skip-generate && next build",
    "docker:up": "docker compose up -d --build",
    "create-admin": "node scripts/create-admin.mjs"
  },
  "dependencies": {
    "@auth/prisma-adapter": "^2.11.1",
    "@hookform/resolvers": "^3.3.0",
    "@neondatabase/serverless": "^1.2.0",
    "@opennextjs/cloudflare": "1.20.13",
    "@prisma/adapter-neon": "6.19.3",
    "@prisma/client": "6.19.3",
    "@prisma/engines": "6.19.3",
    "@stripe/stripe-js": "^3.0.0",
    "@tanstack/react-query": "^5.91.2",
    "@types/nodemailer": "^7.0.11",
    "aws4fetch": "1.0.20",
    "bcryptjs": "^2.4.3",
    "clsx": "^2.1.0",
    "date-fns": "^3.6.0",
    "html2canvas": "^1.4.1",
    "lucide-react": "^0.378.0",
    "next": "^16.4.5",
    "next-auth": "^4.24.15",
    "nodemailer": "^8.0.3",
    "pdf-lib": "1.17.1",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-hook-form": "^7.51.0",
    "react-hot-toast": "^2.6.0",
    "stripe": "^14.0.0",
    "tailwind-merge": "^2.3.0",
    "zod": "^3.23.0",
    "zustand": "^4.5.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@prisma/client",
      "@prisma/engines",
      "esbuild",
      "prisma",
      "sharp",
      "unrs-resolver",
      "workerd"
    ]
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^20.12.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "autoprefixer": "^10.4.0",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.4.5",
    "postcss": "^8.4.0",
    "prisma": "6.19.3",
    "tailwindcss": "^3.4.0",
    "tsx": "^4.11.0",
    "typescript": "^5.4.0",
    "wrangler": "4.148.0"
  },
  "packageManager": "pnpm@10.34.6",
  "license": "Apache-2.0"
}
