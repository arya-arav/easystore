# Copy to .env (Docker Compose) or .env.local (pnpm dev). See docs/configuration.md.

# Required outside Docker Compose
DATABASE_URL="postgresql://user:password@localhost:5432/easystore"
NEXTAUTH_SECRET=""            # openssl rand -hex 32 (Docker generates one if empty)

# Your public address (optional, worked out per request if empty)
SITE_URL=""
NEXTAUTH_URL=""

# Docker Compose only
POSTGRES_PASSWORD="change-me"
PORT=3000

# Picture storage: S3-compatible (required on Vercel; optional elsewhere). See docs/storage.md
S3_BUCKET=""
S3_ENDPOINT=""
S3_REGION="auto"
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""
S3_PUBLIC_URL=""

# Payments (optional; can also be set in Admin → Store settings → Payment)
RAZORPAY_KEY_ID=""
RAZORPAY_KEY_SECRET=""
RAZORPAY_WEBHOOK_SECRET=""
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""

# Google sign-in (optional)
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
